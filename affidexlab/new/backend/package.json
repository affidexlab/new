{
  "name": "decaflow-api-server",
  "version": "1.0.0",
  "description": "DecaFlow Partner API - REST API for swaps, liquidity, and bridges",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "start:sandbox": "ENVIRONMENT=sandbox node src/server.js",
    "build": "node --check src/server.js",
    "ingest:ofac": "node src/scripts/ingest-ofac-sdn-crypto.js",
    "ingest:sanctions": "node src/scripts/ingest-public-sanctions-lists.js",
    "ingest:public-feeds": "node src/scripts/ingest-public-risk-feeds.js",
    "ingest:curated": "node src/scripts/ingest-curated-risk-labels.js",
    "risk:calibrate": "node src/scripts/calibrate-risk-scoring.js",
    "risk:backfill-graph": "node src/scripts/run-risk-graph-backfill.js",
    "shield:scan-security": "node src/scripts/run-shield-security-scan.js",
    "admin:create-key": "node src/scripts/create-admin-api-key.js",
    "org:create": "node src/scripts/create-organization.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.12.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.3",
    "stripe": "^17.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
