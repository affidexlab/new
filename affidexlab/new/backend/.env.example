# Environment
NODE_ENV=production
ENVIRONMENT=production

# Server
PORT=3000

# CORS - Allowed Origins (comma-separated, no spaces)
ALLOWED_ORIGINS=https://decaflow.xyz,https://decaflow.vercel.app,https://tychiwallet.com,https://app.tychiwallet.com

# API Keys
SOCKET_API_KEY=your_socket_api_key_here
ZEROX_API_KEY=your_0x_api_key_here

# Live wallet risk intelligence provider.
# Point this to TRM, Chainalysis, Elliptic, Merkle Science, or a thin adapter
# you control that returns normalized wallet risk fields.
RISK_PROVIDER=custom
RISK_PROVIDER_URL=
RISK_PROVIDER_API_KEY=
RISK_PROVIDER_TIMEOUT_MS=12000
ALLOW_DEMO_RISK=false

# KYC/KYB provider for Institutional/RWA onboarding.
KYC_PROVIDER=custom
KYC_PROVIDER_URL=
KYC_PROVIDER_API_KEY=
KYC_PROVIDER_TIMEOUT_MS=12000

# Database
DATABASE_URL=postgresql://user:password@host:6543/postgres
# If your database provider uses a private/root CA, paste PEM contents here
# with newlines escaped as \n, or set DATABASE_CA_CERT_PATH to a mounted PEM file.
DATABASE_CA_CERT=
DATABASE_CA_CERT_PATH=

# Rate Limiting (optional overrides)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
